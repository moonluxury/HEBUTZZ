; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="河工开物"
run/main_scene="res://scenes/Workbench.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://assets/branding/hegong_zhigu_icon.png"
config/windows_native_icon="res://assets/branding/hegong_zhigu_icon.ico"

[autoload]

AppState="*res://scripts/app_state.gd"
StudyStats="*res://scripts/study_stats.gd"
WindowIcon="*res://scripts/window_icon.gd"
UiMotion="*res://scripts/ui_motion.gd"
UiResources="*res://scripts/ui_resources.gd"
ProfileStore="*res://scripts/profile_store.gd"
AppServices="*res://scripts/app_services.gd"
PageRouter="*res://scripts/page_router.gd"
BackendProvider="*res://scripts/backend_provider.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1680
window/size/mode=2
window/size/window_width_override=1440
window/size/window_height_override=945
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[godot_cef]

storage/data_path="user://submission-browser"

[rendering]

textures/vram_compression/import_etc2_astc=true
