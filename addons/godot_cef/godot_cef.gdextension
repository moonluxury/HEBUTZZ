[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
linux.x86_64   = "bin/x86_64-unknown-linux-gnu/libgdcef.so"
macos          = "bin/universal-apple-darwin/Godot CEF.framework"
windows.x86_64 = "bin/x86_64-pc-windows-msvc-quiet/gdcef.dll"

[icons]
CefTexture = "icons/webview.png"
CefIpcInspector = "icons/webview.png"

[dependencies]

windows.x86_64 = {
  "bin/x86_64-pc-windows-msvc-quiet/gdcef.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/gdcef_helper.exe" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",

  "bin/x86_64-pc-windows-msvc-quiet/locales" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/bootstrap.exe" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/bootstrapc.exe" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/chrome_100_percent.pak" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/chrome_200_percent.pak" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/chrome_elf.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/d3dcompiler_47.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/dxcompiler.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/dxil.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/icudtl.dat" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/libcef.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/resources.pak" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/v8_context_snapshot.bin" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/vk_swiftshader.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/vk_swiftshader_icd.json" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet",
  "bin/x86_64-pc-windows-msvc-quiet/vulkan-1.dll" : "addons/godot_cef/bin/x86_64-pc-windows-msvc-quiet"
}


linux.x86_64 = {
  "bin/x86_64-unknown-linux-gnu/libgdcef.so" : "",
  "bin/x86_64-unknown-linux-gnu/gdcef_helper" : "",

  "bin/x86_64-unknown-linux-gnu/chrome-sandbox" : "",
  "bin/x86_64-unknown-linux-gnu/libcef.so" : "",
  "bin/x86_64-unknown-linux-gnu/libvk_swiftshader.so" : "",
  "bin/x86_64-unknown-linux-gnu/libvulkan.so.1" : "",
  "bin/x86_64-unknown-linux-gnu/v8_context_snapshot.bin" : "",
  "bin/x86_64-unknown-linux-gnu/vk_swiftshader_icd.json" : "",
  "bin/x86_64-unknown-linux-gnu/icudtl.dat" : "",
  "bin/x86_64-unknown-linux-gnu/resources.pak" : "",
  "bin/x86_64-unknown-linux-gnu/chrome_100_percent.pak" : "",
  "bin/x86_64-unknown-linux-gnu/chrome_200_percent.pak" : "",
  "bin/x86_64-unknown-linux-gnu/locales" : ""
}

